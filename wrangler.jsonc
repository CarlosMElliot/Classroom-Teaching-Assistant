{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "classroom-teaching-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "vars": {
    "GOOGLE_REDIRECT_PATH": "/oauth/google/callback"
  },
  "kv_namespaces": [
    {
      "binding": "GOOGLE_TOKENS",
      "id": "f5f5e5ea9fb84b5a84b4a17b65127dfb"
    }
  ]
}
